---
/**
 * projects/ecf-notation.astro
 * Rôle : Page de notation officielle ECF Infoline — évaluateur, commentaire, audio, copie corrigée.
 * Reçoit : aucune prop (page statique)
 * Émet   : aucun
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navbar     from "../../components/Navbar.astro";
import Footer     from "../../components/Footer.astro";
---

<BaseLayout
  title="ECF Infoline — Notation officielle"
  description="Notation officielle de l'ECF Infoline par Ala Atrash — Bachelor Administrateur Système DevOps, RNCP Niveau 6, Studi."
  lang="fr"
>
  <Navbar lang="fr" currentPath="/projects" />

  <main class="ecf-main">

    <header class="page-header">
      <h1 class="page-title">ECF Infoline — Notation officielle</h1>
      <p class="page-sub">Évaluation en Cours de Formation · Bachelor Administrateur Système DevOps · RNCP Niveau 6 · Studi</p>
      <div class="result-badges">
        <span class="badge-at">AT1 — Infrastructure cloud ✓</span>
        <span class="badge-at">AT2 — Déploiement continu ✓</span>
        <span class="badge-at">AT3 — Supervision ✓</span>
      </div>
    </header>

    <section class="section">
      <p class="section-label">Évaluateur</p>
      <div class="evaluator-card">
        <img src="/ala-atrash.jpg" alt="Photo de profil d'Ala Atrash" class="evaluator-photo" />
        <div class="evaluator-info">
          <p class="evaluator-name">Ala Atrash</p>
          <p class="evaluator-title">Fullstack Developer with DevOps orientation</p>
          <a
            href="https://www.linkedin.com/in/ala-atrash-916b12100/"
            target="_blank"
            rel="noopener noreferrer"
            class="linkedin-link"
            aria-label="Voir le profil LinkedIn d'Ala Atrash"
          >
            Voir le profil LinkedIn ↗
          </a>
        </div>
      </div>
    </section>

    <section class="section">
      <p class="section-label">Commentaire & extrait audio</p>
      <div class="notation-block">
        <div class="notation-grid">
          <div class="comment-block">
            <blockquote class="comment-text">
              Validé - Très bon travail - on peut améliorer par une couche de sécurité
              surtout au niveau AWS VPC, subnet, et security group
            </blockquote>
            <p class="notation-date">Évalué par Ala Atrash · 19 février 2026</p>
          </div>
          <div class="audio-block">
            <p class="audio-label">Extrait audio</p>
            <audio controls preload="metadata" class="audio-player">
              <source src="/ala-atrash.mp3" type="audio/mpeg" />
              Votre navigateur ne supporte pas la lecture audio.
            </audio>
          </div>
        </div>
      </div>
    </section>

    <section class="section">
      <p class="section-label">Copie corrigée</p>
      <div class="corrige-block">
        <div class="corrige-icon" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
            <rect x="3" y="2" width="12" height="14" rx="1.5" stroke="currentColor" stroke-width="1.3"/>
            <line x1="6" y1="6" x2="12" y2="6" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
            <line x1="6" y1="9" x2="12" y2="9" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
            <line x1="6" y1="12" x2="9" y2="12" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
          </svg>
        </div>
        <div class="corrige-info">
          <p class="corrige-title">Livret d'évaluations passées en cours de formation</p>
          <p class="corrige-sub">TP-01414 · Administrateur Système DevOps · Niveau 6 · Signé le 19/02/2026</p>
        </div>
        <a href="/ecf-corrige.pdf" download class="corrige-link" aria-label="Télécharger la copie corrigée en PDF">
          Télécharger le PDF
        </a>
      </div>
    </section>

  </main>

  <Footer lang="fr" />
</BaseLayout>

<style>
.ecf-main {
  max-width: 760px;
  margin: 0 auto;
  padding: 3rem 1.5rem 4rem;
}

.page-header {
  margin-bottom: 3rem;
  padding-bottom: 2rem;
  border-bottom: 1px solid var(--color-border);
}

.page-title {
  font-size: 1.75rem;
  font-weight: 500;
  color: var(--color-text-primary);
  margin: 0 0 0.5rem;
}

.page-sub {
  font-size: 0.9rem;
  color: var(--color-text-secondary);
  margin: 0 0 1rem;
  line-height: 1.6;
}

.result-badges {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.badge-at {
  font-size: 0.7rem;
  font-weight: 500;
  padding: 4px 10px;
  border-radius: 20px;
  background: #EAF3DE;
  color: #27500A;
  border: 1px solid #C0DD97;
}

@media (prefers-color-scheme: dark) {
  .badge-at {
    background: #27500A;
    color: #C0DD97;
    border-color: #3B6D11;
  }
}

.section {
  margin-bottom: 2.5rem;
}

.section-label {
  font-size: 0.7rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.07em;
  color: var(--color-text-muted);
  margin-bottom: 1rem;
}

/* ── Évaluateur ─────────────────────────────────────────────────── */
.evaluator-card {
  display: flex;
  align-items: center;
  gap: 1.25rem;
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: 1.25rem;
}

.evaluator-photo {
  width: 72px;
  height: 72px;
  border-radius: 50%;
  object-fit: cover;
  border: 1px solid var(--color-border);
  flex-shrink: 0;
}

.evaluator-info {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.evaluator-name {
  font-size: 1rem;
  font-weight: 500;
  color: var(--color-text-primary);
  margin: 0;
}

.evaluator-title {
  font-size: 0.85rem;
  color: var(--color-text-secondary);
  margin: 0;
}

.linkedin-link {
  font-size: 0.78rem;
  color: var(--color-text-muted);
  text-decoration: none;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-sm);
  padding: 4px 10px;
  margin-top: 4px;
  align-self: flex-start;
  transition: color 0.15s, border-color 0.15s;
}

.linkedin-link:hover {
  color: var(--color-text-primary);
  border-color: var(--color-border-md);
}

/* ── Notation ───────────────────────────────────────────────────── */
.notation-block {
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: 1.25rem;
}

.notation-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1.5rem;
  align-items: start;
}

.comment-text {
  font-size: 0.9rem;
  color: var(--color-text-primary);
  line-height: 1.75;
  margin: 0 0 1rem;
  font-style: italic;
  border-left: 2px solid var(--color-border-md);
  padding-left: 1rem;
}

.notation-date {
  font-size: 0.75rem;
  color: var(--color-text-muted);
  margin: 0;
}

.audio-label {
  font-size: 0.7rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.07em;
  color: var(--color-text-muted);
  margin: 0 0 0.5rem;
}

.audio-player {
  width: 100%;
  border-radius: var(--radius-sm);
}

/* ── Copie corrigée ─────────────────────────────────────────────── */
.corrige-block {
  display: flex;
  align-items: center;
  gap: 1rem;
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: 1.25rem;
}

.corrige-icon {
  width: 36px;
  height: 36px;
  border-radius: var(--radius-sm);
  background: #E6F1FB;
  color: #0C447C;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

@media (prefers-color-scheme: dark) {
  .corrige-icon {
    background: #0C447C;
    color: #B5D4F4;
  }
}

.corrige-info {
  flex: 1;
  min-width: 0;
}

.corrige-title {
  font-size: 0.88rem;
  font-weight: 500;
  color: var(--color-text-primary);
  margin: 0 0 3px;
}

.corrige-sub {
  font-size: 0.78rem;
  color: var(--color-text-muted);
  margin: 0;
}

.corrige-link {
  font-size: 0.78rem;
  color: var(--color-text-muted);
  text-decoration: none;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-sm);
  padding: 6px 14px;
  white-space: nowrap;
  flex-shrink: 0;
  transition: color 0.15s, border-color 0.15s;
}

.corrige-link:hover {
  color: var(--color-text-primary);
  border-color: var(--color-border-md);
}

/* ── Responsive ─────────────────────────────────────────────────── */
@media (max-width: 560px) {
  .notation-grid {
    grid-template-columns: 1fr;
  }

  .evaluator-card {
    flex-direction: column;
    align-items: flex-start;
  }

  .corrige-block {
    flex-wrap: wrap;
  }

  .corrige-link {
    width: 100%;
    text-align: center;
  }
}
</style>
